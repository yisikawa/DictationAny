# Prisma CLI(マイグレーション)専用。アプリ実行時は src/utils/prisma.ts が backend/dev.db を直接参照する
DATABASE_URL="file:./dev.db"
# フロントエンドのオリジン。カンマ区切りで複数指定可。LANアクセスする場合はLAN IPのオリジンを追加
CORS_ORIGIN="https://localhost:5160,https://192.168.111.10:5160"

# Ollama ローカルサーバー設定（OCR AI修正機能で使用）
# Ollama を起動してから使用してください（デフォルトポート: 11434）
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.1:latest"

# ---- 音声取り込み / 文字起こし (STT) ----
# 音声ファイルから教材を作成する機能で使用
STT_PROVIDER="whisper-cpp"                 # whisper-cpp | openai-compatible
STT_TIMEOUT_MS="1800000"
AUDIO_MAX_MB="100"
AUDIO_MAX_DURATION_SEC="3600"

# whisper.cpp（既定プロバイダ。ローカル処理のみで音声を外部送信しない）
# release zip を展開すると実行ファイルは bin\Release\whisper-cli.exe になる
WHISPER_CPP_BIN="C:\\tools\\whisper.cpp\\bin\\Release\\whisper-cli.exe"
# 英語は *.en モデル、他言語は ggml-small.bin などの多言語モデルを指定する
WHISPER_MODEL_PATH="C:\\tools\\whisper.cpp\\models\\ggml-small.en.bin"
WHISPER_THREADS="8"
# 追加フラグ（例: "--suppress-nst" / "--vad -vm C:\\tools\\whisper.cpp\\models\\ggml-silero-v5.1.2.bin"）
WHISPER_EXTRA_ARGS=""
FFMPEG_PATH="ffmpeg"

# OpenAI 互換 STT API（任意。faster-whisper-server / Groq / OpenAI 等）
STT_BASE_URL="http://localhost:8000/v1"
STT_MODEL="whisper-1"
STT_API_KEY=""
